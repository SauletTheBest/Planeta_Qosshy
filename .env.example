# Copy this file to .env and fill in real values. .env is in .gitignore — never commit it.
# Generate random secrets in Git Bash:  openssl rand -base64 32

# Used by docker-compose for the postgres container and the api container
POSTGRES_PASSWORD=change-me

# Used when running the app directly with `go run .` (docker-compose builds its own DSN)
DATABASE_URL=host=localhost port=5432 user=postgres password=change-me dbname=planeta_qosshy sslmode=disable

# Signs the session cookie. At least 32 characters, the app refuses to start otherwise.
COOKIE_SECRET=
# true in production (site served over HTTPS), false for local http://localhost
COOKIE_SECURE=false

VERIFICATION_ADDRESS=http://localhost:8080
# How buyers' browsers reach the shop (the bank sends them back here after paying)
PUBLIC_URL=http://localhost:8080

# Payment service (Qosshy Pay). Two DIFFERENT random secrets, 32+ characters each;
# docker-compose gives the same values to the payments container.
#   PAYMENT_API_KEY        — the shop proves to the bank who it is
#   PAYMENT_WEBHOOK_SECRET — the bank signs its notifications, the shop checks them
PAYMENT_API_URL=http://localhost:8081
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# How long an unpaid order keeps its items reserved
ORDER_RESERVATION_TTL=15m

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where helpdesk messages go (empty = SMTP_USER itself)
SUPPORT_EMAIL=

# Comma-separated IPs of reverse proxies (nginx) in front of the app. Empty = none.
# Only these may set X-Forwarded-For, so clients can't fake their IP to dodge rate limits.
TRUSTED_PROXIES=
# Optional: also write the JSON log to this file (by default it goes to stdout)
LOG_FILE=
